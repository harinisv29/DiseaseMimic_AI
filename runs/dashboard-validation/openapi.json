{
  "openapi": "3.1.0",
  "info": {
    "title": "DiseaseMimic AI Research API",
    "description": "CUDA disease ranking and next-observation suggestions. Exploratory research results; scores are not disease probabilities.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/rank": {
      "post": {
        "summary": "Rank",
        "operationId": "rank_rank_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RankRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/phenotypes": {
      "get": {
        "tags": [
          "Dashboard reference data"
        ],
        "summary": "Search Phenotypes",
        "operationId": "search_phenotypes_dashboard_phenotypes_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 150,
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 15,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Phenotype"
                  },
                  "title": "Response Search Phenotypes Dashboard Phenotypes Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/evidence": {
      "get": {
        "tags": [
          "Dashboard reference data"
        ],
        "summary": "Evidence",
        "operationId": "evidence_dashboard_evidence_get",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 1500,
              "title": "Ids"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DiseaseEvidence"
                  },
                  "title": "Response Evidence Dashboard Evidence Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/metadata": {
      "get": {
        "tags": [
          "Dashboard reference data"
        ],
        "summary": "Metadata",
        "operationId": "metadata_dashboard_metadata_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DiseaseEvidence": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "phenotypes": {
            "items": {
              "$ref": "#/components/schemas/ReferencePhenotype"
            },
            "type": "array",
            "title": "Phenotypes"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "sources",
          "phenotypes"
        ],
        "title": "DiseaseEvidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Phenotype": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "Phenotype"
      },
      "RankRequest": {
        "properties": {
          "present": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Present",
            "examples": [
              [
                "HP:0000135",
                "HP:0001249"
              ]
            ]
          },
          "absent": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Absent"
          },
          "unknown": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unknown"
          },
          "available": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "present"
        ],
        "title": "RankRequest"
      },
      "ReferencePhenotype": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "frequencies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Frequencies"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "state",
          "frequencies",
          "sources"
        ],
        "title": "ReferencePhenotype"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}